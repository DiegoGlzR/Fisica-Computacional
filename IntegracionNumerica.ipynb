   "source": [
    "### Método del Trapecio\n",
    "\n",
    "$f(x) = x^2 + 3x + 9$\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d26fbaff-a38c-4f06-9705-02203e99cc7d",
   "metadata": {},
   "outputs": [],
   "source": [
    "N = 1000000\n",
    "a = -2\n",
    "b = 3\n",
    "h = (b-a)/N\n",
    "fx = 0\n",
    "for x in range(a,b):\n",
    "    fx = (h/2)((x+h)**2 + 3(x+h) + 9) + fx\n",
    "    "
   ]
  },
